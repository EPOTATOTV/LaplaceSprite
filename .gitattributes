# 默认按文本处理，但保留 Windows 脚本的 CRLF
* text=auto

*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# 二进制：禁止自动换行与 diff 文本化
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jfr binary
*.class binary
*.mcpr binary

# 生成产物不参与语言统计
build/** linguist-generated=true
console/dist/** linguist-generated=true
**/build/** linguist-generated=true
